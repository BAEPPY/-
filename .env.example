# 우리말샘 Open API 인증 키 (https://opendict.korean.go.kr/service/openApiInfo)
OPENDICT_API_KEY=여기에_인증키_입력

# 서버 포트
PORT=3000

# 1 로 두면 우리말샘 대신 test/fixtures/mock-dict.json 을 사전으로 사용 (오프라인 개발용)
MOCK_DICT=0

# 1 로 두면 /api/raw?word=... 로 우리말샘 원본 응답을 볼 수 있음 (필드 확인용)
DEBUG=0

# 규칙 미세 조정 (기본값은 모두 "허용하지 않음")
ALLOW_LOANWORDS=0     # 1: 외래어(원어에 로마자 등 외국 문자가 있는 단어) 허용
ALLOW_COMPOUND=0      # 1: 합성어/파생어(표제어에 '-' 가 있는 단어) 허용. 구(^)는 품사가 없어 여전히 불허
ALLOW_DUEUM=1         # 1: 두음법칙 허용 (방 없이 쓰는 /api/validate 의 기본값. 방은 각자 설정)

# 우리말샘 검색 요청에 추가로 붙일 쿼리 문자열 (선택)
# 예: OPENDICT_EXTRA_PARAMS=type1=word&pos=1
OPENDICT_EXTRA_PARAMS=

# 영어 끝말잇기용 단어 목록 (한 줄에 한 단어). 파일이 없으면 처음 실행할 때 내려받아 저장합니다.
# 기본값: data/english-words.txt  /  https://raw.githubusercontent.com/dwyl/english-words/master/words_alpha.txt
ENGLISH_WORDLIST=
ENGLISH_WORDLIST_URL=
ENGLISH_DOWNLOAD=1      # 0 이면 내려받지 않음 (파일이 없으면 영어 모드 비활성화)
